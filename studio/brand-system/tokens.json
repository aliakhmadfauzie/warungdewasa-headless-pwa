{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1.0",
  "name": "Warung Dewasa Deep Forest Nocturne Design System",
  "themePalette": "Deep Forest Nocturne",
  "colors": {
    "primary": {
      "emerald": "#006C4C",
      "emeraldHover": "#059669",
      "mint": "#2DD4BF",
      "mintLight": "#99F6E4"
    },
    "canvas": {
      "active": "#0A1A14",
      "deepForest": "#0A1A14",
      "slate": "#0B0F19",
      "light": "#F8FAF9"
    },
    "surface": {
      "card": "#0F261D",
      "elevated": "#143327",
      "hover": "#1C4435",
      "lightCard": "#FFFFFF"
    },
    "semantic": {
      "amber": "#F59E0B",
      "rose": "#EF4444",
      "sky": "#0EA5E9",
      "shopee": "#EE4D2D",
      "tokopedia": "#03AC0E"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#E2E8F0",
      "muted": "#94A3B8",
      "inverse": "#0A1A14"
    }
  },
  "typography": {
    "fonts": {
      "display": "\"Outfit\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "body": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
    },
    "scaleRatio": 1.15,
    "sizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    }
  },
  "radii": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "full": "9999px"
  },
  "touchTarget": {
    "minHeight": "48px",
    "minWidth": "48px"
  },
  "glass": {
    "level1": {
      "backdropBlur": "12px",
      "background": "rgba(15, 38, 29, 0.75)",
      "border": "1px solid rgba(45, 212, 191, 0.12)"
    },
    "level2": {
      "backdropBlur": "16px",
      "background": "rgba(20, 51, 39, 0.85)",
      "border": "1px solid rgba(45, 212, 191, 0.20)"
    }
  }
}
